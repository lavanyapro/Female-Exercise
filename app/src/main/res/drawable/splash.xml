    <item android:drawable="@color/bg" />
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <shape android:shape="oval"><solid android:color="@color/icon_bg" /></shape>
    </item>
    <item android:gravity="center" android:width="132dp" android:height="132dp"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
